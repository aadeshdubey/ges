# ==============================================================================
# Gayatri Electrical Services (GES) — Git Ignore Policy
# ==============================================================================

# Node & Package Managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# Local Dev Servers & Python HTTP Server Cache
__pycache__/
*.py[cod]
*$py.class
.cache/

# Environment Variables & Private Credentials
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# Operating System Files
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# IDE & Editor Configurations
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak
*.tmp

# AI Agents & Scratch Artifacts
.gemini/
.antigravity/
